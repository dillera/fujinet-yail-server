[Unit]
Description=FujiNet YAIL Server
After=network.target

[Service]
Type=simple
User=fujinet
WorkingDirectory=/opt/fujinet-yail-server/server
# Use the Python interpreter from the virtual environment directly
ExecStart=/opt/fujinet-yail-server/server/venv/bin/python yail.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
