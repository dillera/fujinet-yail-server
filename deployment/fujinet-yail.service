[Unit]
Description=FujiNet YAIL Server
After=network.target

[Service]
# Root of the installed yail-server package and its virtual environment
Environment="YAIL_ROOT=/opt/fujinet-yail-server"
Type=simple
User=fujinet
WorkingDirectory=${YAIL_ROOT}
ExecStart=${YAIL_ROOT}/venv/bin/yail-server --env-file ${YAIL_ROOT}/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
