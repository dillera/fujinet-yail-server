# Image Generation API Configuration
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here_if_needed

# Image Generation Model Configuration
# Options: gpt-image-1 (current OpenAI model), gemini (= gemini-2.5-flash-image),
# or any other OpenAI/Gemini image-capable model name. NOTE: dall-e-* models
# were retired from the OpenAI API and no longer work.
GEN_MODEL=gpt-image-1

# OpenAI-specific Configuration
# gpt-image-1 sizes: 1024x1024, 1536x1024, 1024x1536, auto (quality: low|medium|high|auto)
OPENAI_SIZE=1024x1024
OPENAI_QUALITY=standard
OPENAI_STYLE=vivid
OPENAI_SYSTEM_PROMPT='You are an expert illustrator creating beautiful, imaginative artwork'

# Server port (can also be set with --port)
#YAIL_PORT=5556

# Local file serving (the 'files' command) is OFF unless both of these are
# set (the admin web UI manages them). FILES_PATH must be an absolute folder.
#FILES_ENABLED=false
#FILES_PATH=/absolute/path/to/images

# Streaming (the client slideshow driven by the 'next' command).
# All managed by the admin web UI.
#STREAM_ENABLED=true
#STREAM_MAX_RETRIES=10
#STREAM_RETRY_WAIT=1.0
#STREAM_DOWNLOAD_TIMEOUT=5.0

# Image search: comma-separated ordered DDGS engine names, or 'auto' for all.
# Valid engines depend on the installed ddgs package (currently: bing,
# duckduckgo). Managed by the admin web UI.
#SEARCH_BACKENDS=auto
#SEARCH_MAX_RESULTS=1000

# Uncomment for a specific style prompt
#OPENAI_SYSTEM_PROMPT='You are an expert illustrator creating beautiful, imaginative artwork strictly in the style of Studio Ghibli. Your images feature lush, whimsical scenes, vibrant colors, soft painterly textures, rich natural environments, charming characters, warm lighting, and subtle emotional depth characteristic of films like "My Neighbor Totoro," "Spirited Away," and "Kikis Delivery Service."'
